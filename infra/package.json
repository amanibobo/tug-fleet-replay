{
  "name": "tug-replay-infra",
  "version": "0.1.0",
  "private": true,
  "description": "AWS CDK stack for the tug fleet replay backend (IoT Core -> Lambda -> DynamoDB -> WebSocket, HTTP API, S3 + CloudFront)",
  "bin": {
    "infra": "bin/infra.js"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "test": "jest",
    "synth": "cdk synth --quiet",
    "diff": "cdk diff",
    "deploy": "cdk deploy --require-approval never --outputs-file outputs.json",
    "destroy": "cdk destroy",
    "cdk": "cdk"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.0",
    "aws-cdk": "^2.1144.0",
    "aws-cdk-lib": "^2.272.0",
    "constructs": "^10.4.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.0"
  }
}
