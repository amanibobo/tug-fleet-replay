# static (default): read /data/*.json from public/ and replay in the browser.
# ws: subscribe to a WebSocket and fetch from the REST API.
NEXT_PUBLIC_DATA_MODE=static
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=
# ws mode only: CloudFront base for tug-day JSON and Rerun recordings (stack output CdnUrl)
NEXT_PUBLIC_CDN_URL=
