# Vercel builds only the dashboard (project root directory = dashboard). Keep the Python side out of the upload
# so the CLI does not detect a Python project. Patterns are anchored to the repo root so they do
# not also match dashboard/src/app/docs or dashboard/public/data.
/pipeline
/infra
/data
/docs
/design-plans
/pyproject.toml
/uv.lock
/.venv
/.agents
/.claude
/Makefile
